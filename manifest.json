{
  "manifest_version": 3,
  "name": "Flint Apply",
  "version": "0.1.30",
  "description": "Capture job postings and tailor your resume in Flint Apply.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "alarms",
    "identity",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://localhost:8001/*",
    "http://localhost:3001/*",
    "http://localhost:3100/*",
    "https://www.linkedin.com/*",
    "https://linkedin.com/*",
    "https://*.greenhouse.io/*",
    "https://jobs.lever.co/*",
    "https://*.lever.co/*",
    "https://jobs.ashbyhq.com/*",
    "https://*.ashbyhq.com/*",
    "https://*.myworkdayjobs.com/*",
    "https://*.icims.com/*",
    "https://*.ukg.net/*",
    "https://jobright.ai/*",
    "https://www.jobright.ai/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Flint Apply",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://my.greenhouse.io/*"],
      "js": ["content/my-greenhouse-network.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://my.greenhouse.io/*"],
      "js": ["content/flint-click-guard.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.linkedin.com/jobs/*",
        "https://www.linkedin.com/jobs/*/*",
        "https://www.linkedin.com/jobs/*/*/*",
        "https://linkedin.com/jobs/*",
        "https://linkedin.com/jobs/*/*",
        "https://linkedin.com/jobs/*/*/*",
        "https://*.greenhouse.io/*",
        "https://jobright.ai/jobs/*",
        "https://www.jobright.ai/jobs/*"
      ],
      "js": ["content/jd-extractor.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.greenhouse.io/*",
        "https://jobs.lever.co/*",
        "https://*.lever.co/*",
        "https://jobs.ashbyhq.com/*",
        "https://*.ashbyhq.com/*",
        "https://*.myworkdayjobs.com/*",
        "https://*.icims.com/*",
        "https://*.ukg.net/*",
        "https://jobright.ai/*",
        "https://www.jobright.ai/*",
        "https://www.linkedin.com/jobs/*",
        "https://www.linkedin.com/jobs/*/*",
        "https://www.linkedin.com/jobs/*/*/*",
        "https://linkedin.com/jobs/*",
        "https://linkedin.com/jobs/*/*",
        "https://linkedin.com/jobs/*/*/*"
      ],
      "js": ["content/autofill-runner.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://*.greenhouse.io/*",
        "https://jobs.lever.co/*",
        "https://*.lever.co/*",
        "https://jobs.ashbyhq.com/*",
        "https://*.ashbyhq.com/*",
        "https://*.myworkdayjobs.com/*",
        "https://*.icims.com/*",
        "https://*.ukg.net/*",
        "https://jobright.ai/*",
        "https://www.jobright.ai/*",
        "https://www.linkedin.com/jobs/*",
        "https://www.linkedin.com/jobs/*/*",
        "https://www.linkedin.com/jobs/*/*/*",
        "https://linkedin.com/jobs/*",
        "https://linkedin.com/jobs/*/*",
        "https://linkedin.com/jobs/*/*/*"
      ],
      "js": ["content/floating-shell.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "popup/index.html",
        "popup/*",
        "assets/*",
        "chunks/*",
        "brand/*",
        "icons/icon48.png"
      ],
      "matches": [
        "https://flintapply.com/*",
        "https://*.flintapply.com/*",
        "https://*.greenhouse.io/*",
        "https://jobs.lever.co/*",
        "https://*.lever.co/*",
        "https://jobs.ashbyhq.com/*",
        "https://*.ashbyhq.com/*",
        "https://*.myworkdayjobs.com/*",
        "https://*.icims.com/*",
        "https://*.ukg.net/*",
        "https://jobright.ai/*",
        "https://www.jobright.ai/*",
        "https://www.linkedin.com/*",
        "https://linkedin.com/*",
        "https://*/*"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "flint@flint.app",
      "strict_min_version": "128.0"
    }
  }
}
