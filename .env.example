# Default: Flint Apply `pnpm dev` (frontend :3100, API :8000 — see smart-resume no-host-port-3000 rule)
VITE_API_BASE_URL=http://localhost:8000
VITE_WEB_APP_BASE_URL=http://localhost:3100

# Same Google OAuth client ID as the backend. The secret stays server-side.
# Register these redirect URIs on that Google OAuth client:
#   http://localhost:3100/auth/extension/google/callback   — dev
#   http://localhost:3001/auth/extension/google/callback — local staging sim
# (Do NOT use /api/auth/callback/google — that route belongs to NextAuth.)
VITE_GOOGLE_CLIENT_ID=

# Same GitHub OAuth App client ID as the backend. The secret stays server-side.
# GitHub OAuth Apps allow exactly ONE registered callback URL, and the
# runtime redirect_uri must be a subdirectory of it. One GitHub OAuth App
# serves both the website (NextAuth's default /api/auth/callback/github)
# and this extension (/auth/extension/github/callback) — so register the
# SITE ROOT, not either specific path, as this app's callback URL:
#   http://localhost:3100/   — dev (site root; NOT /auth/extension/github/callback)
# Registering the extension's specific path instead would break the
# website's GitHub login, since /api/auth/callback/github is not a
# subdirectory of it.
# Leave empty to hide the GitHub sign-in button (optional feature).
VITE_GITHUB_CLIENT_ID=

# Same Microsoft Entra ID (Azure AD) app client ID as the backend. The secret
# stays server-side. Unlike GitHub above, Entra apps can register multiple
# exact redirect URIs, so registering this extension's specific path here is
# correct as-is and needs no site-root workaround:
#   http://localhost:3100/auth/extension/microsoft/callback — dev
# Leave empty to hide the Microsoft sign-in button (optional feature).
VITE_MICROSOFT_CLIENT_ID=

# Local staging sim: cp .env.staging .env && npm run build
