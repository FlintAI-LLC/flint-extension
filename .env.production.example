# Production build — copy to .env before `npm run build`
VITE_API_BASE_URL=https://api.flintapply.com
VITE_WEB_APP_BASE_URL=https://flintapply.com
# Register https://flintapply.com/auth/extension/google/callback on the OAuth client
VITE_GOOGLE_CLIENT_ID=
# Register https://flintapply.com/ (SITE ROOT — not the extension-specific
# path below) on the GitHub OAuth App. GitHub allows only one callback URL
# per app, and the runtime redirect_uri must be a subdirectory of it; the
# same app serves both the website's /api/auth/callback/github and this
# extension's /auth/extension/github/callback, so only the site root works
# for both. Registering the extension's specific path instead breaks the
# website's GitHub login.
# (leave empty to hide the GitHub sign-in button)
VITE_GITHUB_CLIENT_ID=
# Register https://flintapply.com/auth/extension/microsoft/callback on the Entra ID app
# (unlike GitHub above, Entra apps support multiple exact redirect URIs, so
# this per-path registration is correct as-is)
# (leave empty to hide the Microsoft sign-in button)
VITE_MICROSOFT_CLIENT_ID=
